<%# Included by src/abc/instruction.cc. Source is pinned ISA only. %>
<%
roles = {
  v: 'kRegister', imm: 'kImmediate', method_id: 'kMethod',
  type_id: 'kType', field_id: 'kField', string_id: 'kString',
  literalarray_id: 'kLiteralArray'
}
instructions = Panda.instructions
max_operands = instructions.map { |instruction| instruction.operands.size }.max
raise 'operand count changed between templates' unless max_operands > 0
primary_ordinals = Array.new(256, 'kInvalidInstructionOrdinal')
prefixes = Panda.prefixes
prefix_groups = Array.new(256, 'kInvalidPrefixGroup')
prefixed_ordinals = prefixes.map { Array.new(256, 'kInvalidInstructionOrdinal') }
prefixes.each_with_index { |prefix, group| prefix_groups[prefix.opcode_idx] = group.to_s }
instructions.each_with_index do |instruction, ordinal|
  opcode = instruction.opcode_idx
  if instruction.prefix
    group = prefixes.index { |prefix| prefix.opcode_idx == (opcode & 0xff) }
    raise 'instruction has unknown prefix' unless group
    secondary = opcode >> 8
    raise 'duplicate prefixed opcode' unless prefixed_ordinals[group][secondary] == 'kInvalidInstructionOrdinal'
    prefixed_ordinals[group][secondary] = ordinal.to_s
  else
    raise 'duplicate primary opcode' unless primary_ordinals[opcode] == 'kInvalidInstructionOrdinal'
    primary_ordinals[opcode] = ordinal.to_s
  end
end
%>
inline constexpr std::array<InstructionSpec, <%= instructions.size %>>
    kInstructionSpecs = {{
<% instructions.each do |instruction| %>
      {Opcode::k<%= instruction.opcode.upcase %>,
       <%= instruction.format.size %>, <%= instruction.operands.size %>,
       std::array<OperandSpec, kMaxInstructionOperands>{
<% instruction.operands.each do |operand| %>
           OperandSpec{OperandKind::<%= roles.fetch(operand.name) %>,
                       OperandAccess::<%= operand.src? && operand.dst? ? 'kReadWrite' : operand.dst? ? 'kWrite' : 'kRead' %>,
                       <%= operand.width %>, <%= operand.offset %>,
                       <%= operand.is_signed_imm? %>,
                       <%= operand.is_float_imm? %>},
<% end %>
       },
       <%= instruction.jump? %>, <%= instruction.conditional? %>,
       <%= instruction.acc_read? %>, <%= instruction.acc_write? %>},
<% end %>
    }};

inline constexpr std::array<std::uint16_t, 256> kPrimaryOrdinals = {
<% primary_ordinals.each_slice(8) do |slice| %>
    <%= slice.join(', ') %>,
<% end %>
};

inline constexpr std::array<std::uint8_t, 256> kPrefixGroups = {
<% prefix_groups.each_slice(8) do |slice| %>
    <%= slice.join(', ') %>,
<% end %>
};

inline constexpr std::array<std::array<std::uint16_t, 256>, <%= prefixes.size %>>
    kPrefixedOrdinals = {{
<% prefixed_ordinals.each do |ordinals| %>
        {
<% ordinals.each_slice(8) do |slice| %>
            <%= slice.join(', ') %>,
<% end %>
        },
<% end %>
    }};
