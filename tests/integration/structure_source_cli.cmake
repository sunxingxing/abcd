string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/structure-source-${token}")
execute_process(COMMAND "${ABCD_FIXTURE}" "${root}/input" --module-record
  RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "fixture failed")
endif()
execute_process(COMMAND "${ABCD_STRUCTURE}"
  "${root}/input/dynamic.abc" "${root}/fixture-output" --source
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "fixture source export failed: ${error}")
endif()
file(READ "${root}/fixture-output/manifest.json" fixture_manifest)
string(JSON fixture_source ERROR_VARIABLE missing GET "${fixture_manifest}" records 0 source)
if(NOT missing OR EXISTS "${root}/fixture-output/${fixture_source}")
  message(FATAL_ERROR "unproved fixture produced executable source")
endif()
execute_process(COMMAND "${ABCD_STRUCTURE}"
  "${root}/input/static.abc" "${root}/static-output" --source
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0 OR EXISTS "${root}/static-output")
  message(FATAL_ERROR "static input published executable source")
endif()
execute_process(COMMAND "${ABCD_STRUCTURE}" "${ABCD_SAMPLE}"
  "${root}/sample-output" --source RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "sample source export failed: ${error}")
endif()
file(READ "${root}/sample-output/manifest.json" manifest)
string(JSON count GET "${manifest}" counts records)
set(found FALSE)
set(found_static FALSE)
set(found_routes FALSE)
set(found_backup FALSE)
math(EXPR last "${count} - 1")
foreach(i RANGE 0 ${last})
  string(JSON source ERROR_VARIABLE missing GET "${manifest}" records ${i} source)
  if(missing)
    continue()
  endif()
  if(source MATCHES "Breakpoint")
    set(found TRUE)
    execute_process(COMMAND "${ABCD_NODE}" --experimental-vm-modules
      "${ABCD_ORACLE}" "${root}/sample-output/${source}"
      RESULT_VARIABLE oracle_status ERROR_VARIABLE oracle_error)
    if(NOT oracle_status EQUAL 0)
      message(FATAL_ERROR "record source oracle failed: ${oracle_error}")
    endif()
  elseif(source MATCHES "CommonConstants")
    set(found_static TRUE)
    execute_process(COMMAND "${ABCD_NODE}" --experimental-vm-modules
      "${ABCD_STATIC_ORACLE}" "${root}/sample-output/${source}"
      RESULT_VARIABLE oracle_status ERROR_VARIABLE oracle_error)
    if(NOT oracle_status EQUAL 0)
      message(FATAL_ERROR "static field oracle failed: ${oracle_error}")
    endif()
  elseif(source MATCHES "constants/Constants")
    set(found_routes TRUE)
    execute_process(COMMAND "${ABCD_NODE}" "${ABCD_ROUTES_ORACLE}"
      "${root}/sample-output/${source}"
      RESULT_VARIABLE oracle_status ERROR_VARIABLE oracle_error)
    if(NOT oracle_status EQUAL 0)
      message(FATAL_ERROR "record literal oracle failed: ${oracle_error}")
    endif()
  elseif(source MATCHES "EntryBackupAbility")
    set(found_backup TRUE)
    execute_process(COMMAND "${ABCD_NODE}" --experimental-vm-modules
      "${ABCD_BACKUP_ORACLE}" "${root}/sample-output/${source}"
      RESULT_VARIABLE oracle_status ERROR_VARIABLE oracle_error)
    if(NOT oracle_status EQUAL 0)
      message(FATAL_ERROR "backup ability oracle failed: ${oracle_error}")
    endif()
  endif()
endforeach()
if(NOT found OR NOT found_static OR NOT found_routes OR NOT found_backup)
  message(FATAL_ERROR "expected record sources missing")
endif()
file(GLOB partials "${root}/*.partial.*")
if(partials)
  message(FATAL_ERROR "source export left staging trees")
endif()
file(REMOVE_RECURSE "${root}")
