string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/references-${token}")
foreach(mode IN ITEMS reference-method invalid-reference)
  execute_process(COMMAND "${ABCD_FIXTURE}" "${root}/${mode}" "--${mode}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "fixture failed")
  endif()
  execute_process(COMMAND "${ABCD_SCAN}" "${root}/${mode}.json" fixture "${root}/${mode}"
    RESULT_VARIABLE status OUTPUT_QUIET)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "scan failed")
  endif()
  execute_process(COMMAND "${ABCD_REFERENCES}" "${root}/${mode}.json" fixture "${root}/${mode}"
    RESULT_VARIABLE status OUTPUT_VARIABLE report)
  if(mode STREQUAL "reference-method")
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "reference validation failed: ${report}")
    endif()
    foreach(key IN ITEMS reference_methods string_literals literal_arrays literal_entries static_skipped)
      string(JSON value GET "${report}" ${key})
      if(NOT value EQUAL 1)
        message(FATAL_ERROR "bad ${key}: ${report}")
      endif()
    endforeach()
    string(JSON value GET "${report}" unique_references)
    if(NOT value EQUAL 2)
      message(FATAL_ERROR "missing references: ${report}")
    endif()
  else()
    if(status EQUAL 0)
      message(FATAL_ERROR "invalid reference accepted")
    endif()
    string(JSON value GET "${report}" failed_reference_methods)
    if(NOT value EQUAL 1)
      message(FATAL_ERROR "bad failure counts: ${report}")
    endif()
  endif()
endforeach()
file(REMOVE_RECURSE "${root}")
