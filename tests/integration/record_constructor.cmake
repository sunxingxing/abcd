string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/record-constructor-${token}")
execute_process(COMMAND "${ABCD_STRUCTURE}" "${ABCD_SAMPLE}" "${root}" --source
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "record source export failed: ${error}")
endif()
file(READ "${root}/manifest.json" manifest)
string(JSON count GET "${manifest}" counts records)
math(EXPR last "${count} - 1")
set(found FALSE)
foreach(i RANGE 0 ${last})
  string(JSON entity GET "${manifest}" records ${i} entity)
  if(NOT entity EQUAL 4466)
    continue()
  endif()
  string(JSON source_error GET "${manifest}" records ${i} source_error)
  string(JSON source_pc GET "${manifest}" records ${i} source_pc)
  string(JSON source ERROR_VARIABLE missing GET "${manifest}" records ${i} source)
  if(NOT missing OR NOT source_error EQUAL 7 OR NOT source_pc EQUAL 43)
    message(FATAL_ERROR "Logger class-method refusal changed")
  endif()
  set(found TRUE)
endforeach()
if(NOT found)
  message(FATAL_ERROR "Logger record missing")
endif()
file(REMOVE_RECURSE "${root}")
