string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/record-viewmodels-${token}")
set(icon_entity 29119)
set(section_entity 29619)
set(written_status 0)
execute_process(COMMAND "${ABCD_STRUCTURE}" "${ABCD_SAMPLE}" "${root}" --value-source
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "record source export failed: ${error}")
endif()
file(READ "${root}/manifest.json" manifest)
string(JSON count GET "${manifest}" counts records)
math(EXPR last "${count} - 1")
set(icon_path "")
set(section_path "")
set(icon_model_path "")
set(section_model_path "")
foreach(i RANGE 0 ${last})
  string(JSON entity GET "${manifest}" records ${i} entity)
  if(NOT entity EQUAL icon_entity AND NOT entity EQUAL section_entity AND
     NOT entity EQUAL 16752 AND NOT entity EQUAL 17544)
    continue()
  endif()
  string(JSON source ERROR_VARIABLE missing GET "${manifest}" records ${i} source)
  string(JSON source_status GET "${manifest}" records ${i} source_status)
  if(missing OR NOT source_status EQUAL written_status)
    message(FATAL_ERROR "viewmodel record ${entity} source unavailable")
  endif()
  string(JSON complete GET "${manifest}" records ${i} source_complete)
  string(JSON legacy ERROR_VARIABLE legacy_absent GET "${manifest}" records ${i} legacy_writer_used)
  if(NOT complete OR NOT legacy_absent)
    message(FATAL_ERROR "viewmodel record ${entity} requires a complete value-tree record")
  endif()
  if(entity EQUAL icon_entity)
    set(icon_path "${root}/${source}")
  elseif(entity EQUAL section_entity)
    set(section_path "${root}/${source}")
  elseif(entity EQUAL 16752)
    set(icon_model_path "${root}/${source}")
  else()
    set(section_model_path "${root}/${source}")
  endif()
endforeach()
if(icon_path STREQUAL "" OR section_path STREQUAL "" OR
   icon_model_path STREQUAL "" OR section_model_path STREQUAL "")
  message(FATAL_ERROR "viewmodel record missing")
endif()
get_filename_component(sample_root "${ABCD_SAMPLE}" DIRECTORY)
set(paired_root "${sample_root}/Immersive_src/shopping/src/main/ets")
execute_process(COMMAND "${ABCD_NODE}" --experimental-vm-modules
  "${ABCD_ORACLE}" "${icon_path}" "${section_path}"
  "${icon_model_path}" "${section_model_path}" "${paired_root}"
  RESULT_VARIABLE oracle_status ERROR_VARIABLE oracle_error OUTPUT_VARIABLE oracle_output)
if(NOT oracle_status EQUAL 0)
  message(FATAL_ERROR "viewmodel record behavior changed: ${oracle_error}")
endif()
message(STATUS "${oracle_output}")
file(REMOVE_RECURSE "${root}")
