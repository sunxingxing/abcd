string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/record-viewmodels-${token}")
set(icon_entity 29119)
set(section_entity 29619)
set(written_status 0)
execute_process(COMMAND "${ABCD_STRUCTURE}" "${ABCD_SAMPLE}" "${root}" --source
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "record source export failed: ${error}")
endif()
file(READ "${root}/manifest.json" manifest)
string(JSON count GET "${manifest}" counts records)
math(EXPR last "${count} - 1")
set(icon_path "")
set(section_path "")
foreach(i RANGE 0 ${last})
  string(JSON entity GET "${manifest}" records ${i} entity)
  if(NOT entity EQUAL icon_entity AND NOT entity EQUAL section_entity)
    continue()
  endif()
  string(JSON source ERROR_VARIABLE missing GET "${manifest}" records ${i} source)
  string(JSON source_status GET "${manifest}" records ${i} source_status)
  if(missing OR NOT source_status EQUAL written_status)
    message(FATAL_ERROR "viewmodel record ${entity} source unavailable")
  endif()
  if(entity EQUAL icon_entity)
    set(icon_path "${root}/${source}")
  else()
    set(section_path "${root}/${source}")
  endif()
endforeach()
if(icon_path STREQUAL "" OR section_path STREQUAL "")
  message(FATAL_ERROR "viewmodel record missing")
endif()
execute_process(COMMAND "${ABCD_NODE}" --experimental-vm-modules
  "${ABCD_ORACLE}" "${icon_path}" "${section_path}"
  RESULT_VARIABLE oracle_status ERROR_VARIABLE oracle_error)
if(NOT oracle_status EQUAL 0)
  message(FATAL_ERROR "viewmodel record behavior changed: ${oracle_error}")
endif()
file(REMOVE_RECURSE "${root}")
