set(ABCD_DECODE "${ABCD_FLOW}")
include("${CMAKE_CURRENT_LIST_DIR}/decode_cli.cmake")
execute_process(COMMAND "${ABCD_FIXTURE}" "${root}/fallthrough" --fallthrough-method
  RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "flow fixture generation failed")
endif()
execute_process(COMMAND "${ABCD_SCAN}" "${root}/flow.json" fixture "${root}/fallthrough"
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "flow fixture scan failed")
endif()
execute_process(COMMAND "${ABCD_FLOW}" "${root}/flow.json" fixture "${root}/fallthrough"
  RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic)
if(status EQUAL 0)
  message(FATAL_ERROR "accepted fall-off-end method")
endif()
foreach(key IN ITEMS decoded_methods failed_methods flow_methods failed_flow_methods)
  string(JSON ${key} GET "${report}" ${key})
endforeach()
if(NOT decoded_methods EQUAL 1 OR NOT failed_methods EQUAL 0
    OR NOT flow_methods EQUAL 0 OR NOT failed_flow_methods EQUAL 1)
  message(FATAL_ERROR "flow failure confused with decode failure: ${report}")
endif()
string(JSON stage GET "${report}" results 0 method_failures 0 stage)
if(NOT stage STREQUAL "normal_flow")
  message(FATAL_ERROR "flow diagnostic stage missing: ${report}")
endif()
file(REMOVE_RECURSE "${root}")
