string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/source-probe-${token}")
foreach(mode IN ITEMS --frame-method --source-string --method --source-method --source-loop --source-exception --source-name-budget --invalid-method)
  execute_process(COMMAND "${ABCD_FIXTURE}" "${root}" "${mode}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "fixture failed")
  endif()
  execute_process(COMMAND "${ABCD_SCAN}" "${root}/index.json" fixture "${root}"
    RESULT_VARIABLE status OUTPUT_QUIET)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "scan failed")
  endif()
  execute_process(COMMAND "${ABCD_PROBE}" "${root}/index.json" fixture "${root}"
    RESULT_VARIABLE status OUTPUT_VARIABLE report)
  if(mode STREQUAL "--invalid-method")
    if(NOT status EQUAL 1)
      message(FATAL_ERROR "bad decode accepted: ${status}")
    endif()
    string(JSON value GET "${report}" failed_methods)
  else()
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "probe failed: ${status} ${report}")
    endif()
    if(mode STREQUAL "--frame-method" OR mode STREQUAL "--source-string")
      string(JSON value GET "${report}" source_body_ready)
      string(JSON bytes GET "${report}" source_bytes)
      if(NOT bytes GREATER 0)
        message(FATAL_ERROR "no source rendered")
      endif()
    else()
      string(JSON value GET "${report}" source_body_rejected)
      string(JSON category GET "${report}" source_obstacles 0 category)
      if(mode STREQUAL "--method" AND NOT category STREQUAL "frame")
        message(FATAL_ERROR "missing frame rejection: ${report}")
      endif()
      if(mode STREQUAL "--source-method")
        string(JSON opcode GET "${report}" source_obstacles 0 opcode)
        if(NOT category STREQUAL "accumulator" OR NOT opcode EQUAL 6)
          message(FATAL_ERROR "missing unsupported array creation: ${report}")
        endif()
      endif()
      if(mode STREQUAL "--source-name-budget" AND NOT category STREQUAL "probe")
        message(FATAL_ERROR "missing name budget rejection: ${report}")
      endif()
      if(mode STREQUAL "--source-loop" OR mode STREQUAL "--source-exception" OR mode STREQUAL "--source-name-budget")
        string(JSON opcode ERROR_VARIABLE absent GET "${report}" source_obstacles 0 opcode)
        if(NOT absent)
          message(FATAL_ERROR "structure rejection incorrectly attributed to opcode")
        endif()
        if(mode STREQUAL "--source-loop" AND NOT category STREQUAL "order")
          message(FATAL_ERROR "missing cycle rejection: ${report}")
        endif()
        if(mode STREQUAL "--source-exception" AND NOT category STREQUAL "body")
          message(FATAL_ERROR "missing exception rejection: ${report}")
        endif()
      endif()
    endif()
  endif()
  if(NOT value EQUAL 1)
    message(FATAL_ERROR "wrong method count: ${report}")
  endif()
  string(JSON skipped GET "${report}" static_skipped)
  if(NOT skipped EQUAL 1)
    message(FATAL_ERROR "static sample was not skipped")
  endif()
endforeach()
file(REMOVE_RECURSE "${root}")
