string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/structure-${token}")
execute_process(COMMAND "${ABCD_FIXTURE}" "${root}/input" --module-record RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "fixture failed")
endif()
execute_process(COMMAND "${ABCD_STRUCTURE}" "${root}/input/dynamic.abc" "${root}/output"
  RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "structure failed: ${error}")
endif()
file(READ "${root}/output/manifest.json" manifest)
string(JSON count GET "${manifest}" counts records)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "record count mismatch")
endif()
string(JSON metadata GET "${manifest}" records 0 metadata)
string(JSON declarations GET "${manifest}" records 0 declarations)
file(READ "${root}/output/${metadata}" record)
file(READ "${root}/output/${declarations}" declaration)
string(JSON view GET "${record}" view)
string(JSON descriptor GET "${record}" descriptor)
if(NOT view STREQUAL "structure_only" OR NOT descriptor STREQUAL "Ldemo;")
  message(FATAL_ERROR "record identity lost")
endif()
string(FIND "${declaration}" "No function bodies recovered" marker)
if(marker EQUAL -1)
  message(FATAL_ERROR "declaration view not labeled")
endif()
execute_process(COMMAND "${ABCD_STRUCTURE}" "${root}/input/dynamic.abc" "${root}/output"
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
  message(FATAL_ERROR "existing destination overwritten")
endif()
execute_process(COMMAND "${ABCD_STRUCTURE}" "${root}/input/static.abc" "${root}/static-output"
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0 OR EXISTS "${root}/static-output")
  message(FATAL_ERROR "static input published")
endif()
string(ASCII 255 invalid_utf8)
execute_process(COMMAND "${ABCD_STRUCTURE}" "${root}/input/dynamic.abc" "${root}/${invalid_utf8}"
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0 OR EXISTS "${root}/${invalid_utf8}")
  message(FATAL_ERROR "invalid report path published")
endif()
file(GLOB partials "${root}/*.partial.*")
if(partials)
  message(FATAL_ERROR "failed exports left staging trees")
endif()
file(REMOVE_RECURSE "${root}")
