string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(root "${CMAKE_CURRENT_BINARY_DIR}/decode_cli_fixture_${nonce}")
foreach(kind IN ITEMS method invalid-method many-invalid-methods)
  set(expected_methods 1)
  if(kind STREQUAL "many-invalid-methods")
    set(expected_methods 65)
  endif()
  execute_process(COMMAND "${ABCD_FIXTURE}" "${root}/${kind}" "--${kind}"
    RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "decode fixture creation failed")
  endif()
  execute_process(COMMAND "${ABCD_SCAN}" "${root}/${kind}.json" fixture "${root}/${kind}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "decode fixture classification failed")
  endif()
  execute_process(COMMAND "${ABCD_DECODE}" "${root}/${kind}.json" fixture "${root}/${kind}"
    RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic)
  if(kind STREQUAL "method")
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "valid body rejected: ${status}: ${diagnostic}")
    endif()
  elseif(status EQUAL 0)
    message(FATAL_ERROR "invalid opcode accepted")
  endif()
  foreach(key IN ITEMS indexed static_skipped methods decoded_methods failed_methods instructions failed)
    string(JSON ${key} GET "${report}" ${key})
  endforeach()
  if(NOT indexed EQUAL 1 OR NOT static_skipped EQUAL 1 OR NOT methods EQUAL expected_methods)
    message(FATAL_ERROR "incorrect metadata counts: ${report}")
  endif()
  if(kind STREQUAL "method")
    if(NOT decoded_methods EQUAL 1 OR NOT instructions EQUAL 1
        OR NOT failed_methods EQUAL 0 OR NOT failed EQUAL 0)
      message(FATAL_ERROR "incorrect valid decode counts: ${report}")
    endif()
  elseif(NOT failed_methods EQUAL expected_methods OR NOT decoded_methods EQUAL 0 OR NOT failed EQUAL 1)
    message(FATAL_ERROR "incorrect failed decode counts: ${report}")
  endif()
  string(JSON diagnostics LENGTH "${report}" results 0 method_failures)
  if(NOT diagnostics EQUAL failed_methods)
    message(FATAL_ERROR "method failure diagnostics were lost: ${diagnostics}/${failed_methods}")
  endif()
endforeach()
file(REMOVE_RECURSE "${root}")
