string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/frames-${token}")
foreach(mode IN ITEMS --frame-method --method)
  execute_process(COMMAND "${ABCD_FIXTURE}" "${root}" "${mode}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "fixture failed")
  endif()
  execute_process(COMMAND "${ABCD_SCAN}" "${root}/index.json" fixture "${root}"
    RESULT_VARIABLE status OUTPUT_QUIET)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "scan failed")
  endif()
  execute_process(COMMAND "${ABCD_FRAMES}" "${root}/index.json" fixture "${root}"
    RESULT_VARIABLE status OUTPUT_VARIABLE report)
  if(mode STREQUAL "--frame-method")
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "frame inspection failed: ${status} ${report}")
    endif()
    foreach(key IN ITEMS frame_methods default_call_type_methods static_skipped)
      string(JSON value GET "${report}" ${key})
      if(NOT value EQUAL 1)
        message(FATAL_ERROR "bad ${key}: ${report}")
      endif()
    endforeach()
    string(JSON value GET "${report}" hidden_slots)
    if(NOT value EQUAL 3)
      message(FATAL_ERROR "bad hidden slots: ${report}")
    endif()
  else()
    if(NOT status EQUAL 1)
      message(FATAL_ERROR "underflow accepted: ${status} ${report}")
    endif()
    string(JSON value GET "${report}" failed_frame_methods)
    if(NOT value EQUAL 1)
      message(FATAL_ERROR "missing frame failure: ${report}")
    endif()
  endif()
endforeach()
file(REMOVE_RECURSE "${root}")
