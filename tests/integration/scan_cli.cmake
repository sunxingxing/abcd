set(root "${CMAKE_CURRENT_BINARY_DIR}/scan_cli_fixture")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}/corpus")
file(WRITE "${root}/corpus/bad.abc" "bad")
foreach(pass RANGE 1 2)
  execute_process(COMMAND "${ABCD_SCAN}" "${root}/index.json" fixture "${root}/corpus"
    RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "scan failed: ${status}: ${diagnostic}")
  endif()
  string(JSON files GET "${report}" files)
  string(JSON invalid GET "${report}" invalid)
  string(JSON classified GET "${report}" classified)
  string(JSON reused GET "${report}" reused)
  string(JSON rss GET "${report}" peak_rss_bytes)
  if(NOT files EQUAL 1 OR NOT invalid EQUAL 1 OR rss GREATER 1000000000)
    message(FATAL_ERROR "wrong scan report: ${report}")
  endif()
  if(pass EQUAL 1 AND (NOT classified EQUAL 1 OR NOT reused EQUAL 0))
    message(FATAL_ERROR "first scan did not classify: ${report}")
  endif()
  if(pass EQUAL 2 AND (NOT classified EQUAL 0 OR NOT reused EQUAL 1))
    message(FATAL_ERROR "second scan did not reuse: ${report}")
  endif()
endforeach()
execute_process(COMMAND "${ABCD_SCAN}" RESULT_VARIABLE status
  OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
  message(FATAL_ERROR "missing arguments accepted")
endif()
file(REMOVE_RECURSE "${root}")
