string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(root "${CMAKE_CURRENT_BINARY_DIR}/index_cli_fixture_${nonce}")
execute_process(COMMAND "${ABCD_FIXTURE}" "${root}/corpus"
  RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "fixture generation failed: ${status}")
endif()
execute_process(COMMAND "${ABCD_SCAN}" "${root}/manifest.json" fixture "${root}/corpus"
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE diagnostic)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "fixture classification failed: ${diagnostic}")
endif()
foreach(pass RANGE 1 2)
  execute_process(COMMAND "${ABCD_INDEX}" "${root}/manifest.json" fixture "${root}/corpus"
    RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "indexing failed: ${status}: ${diagnostic}")
  endif()
  foreach(key IN ITEMS files indexed static_skipped records methods failed peak_rss_bytes)
    string(JSON ${key} GET "${report}" ${key})
  endforeach()
  if(NOT files EQUAL 2 OR NOT indexed EQUAL 1 OR NOT static_skipped EQUAL 1
      OR NOT records EQUAL 1 OR NOT methods EQUAL 0 OR NOT failed EQUAL 0
      OR peak_rss_bytes GREATER 1000000000)
    message(FATAL_ERROR "wrong index report: ${report}")
  endif()
endforeach()
find_program(PRLIMIT prlimit REQUIRED)
execute_process(COMMAND "${PRLIMIT}" --as=134217728:1000000000
  "${ABCD_INDEX}" "${root}/manifest.json" fixture "${root}/corpus"
  RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "inherited-limit run failed: ${diagnostic}")
endif()
string(JSON limit GET "${report}" address_space_limit_bytes)
if(NOT limit EQUAL 134217728)
  message(FATAL_ERROR "inherited memory limit was raised: ${report}")
endif()
file(READ "${root}/manifest.json" manifest)
string(JSON stale SET "${manifest}" entries 0 detector_revision 999)
file(WRITE "${root}/stale.json" "${stale}")
execute_process(COMMAND "${ABCD_INDEX}" "${root}/stale.json" fixture "${root}/corpus"
  RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_QUIET)
if(status EQUAL 0)
  message(FATAL_ERROR "stale detector revision accepted")
endif()
string(JSON outcome GET "${report}" results 0 outcome)
if(NOT outcome STREQUAL "stale_manifest")
  message(FATAL_ERROR "wrong stale revision outcome: ${report}")
endif()
execute_process(COMMAND "${ABCD_INDEX}" "${root}/manifest.json"
  fixture "${root}/corpus" missing "${root}/corpus"
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
  message(FATAL_ERROR "root absent from manifest silently accepted")
endif()
file(APPEND "${root}/corpus/dynamic.abc" "changed")
execute_process(COMMAND "${ABCD_INDEX}" "${root}/manifest.json" fixture "${root}/corpus"
  RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_QUIET)
if(status EQUAL 0)
  message(FATAL_ERROR "changed content accepted using stale manifest")
endif()
string(JSON failed GET "${report}" failed)
if(NOT failed EQUAL 1)
  message(FATAL_ERROR "changed content not reported: ${report}")
endif()
string(JSON outcome GET "${report}" results 0 outcome)
if(NOT outcome STREQUAL "stale_manifest")
  message(FATAL_ERROR "wrong changed content outcome: ${report}")
endif()
execute_process(COMMAND "${ABCD_INDEX}" RESULT_VARIABLE status
  OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
  message(FATAL_ERROR "missing arguments accepted")
endif()
file(REMOVE_RECURSE "${root}")
