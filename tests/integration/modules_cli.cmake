string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/modules-${token}")
execute_process(COMMAND "${ABCD_FIXTURE}" "${root}" --module-record RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "module fixture failed")
endif()
execute_process(COMMAND "${ABCD_SCAN}" "${root}/index.json" fixture "${root}"
  RESULT_VARIABLE status OUTPUT_QUIET)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "scan failed")
endif()
execute_process(COMMAND "${ABCD_MODULES}" "${root}/index.json" fixture "${root}"
  RESULT_VARIABLE status OUTPUT_VARIABLE report)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "module inspection failed: ${report}")
endif()
foreach(key IN ITEMS modules checked_records merged_files static_skipped)
  string(JSON value GET "${report}" ${key})
  if(NOT value EQUAL 1)
    message(FATAL_ERROR "bad ${key}: ${report}")
  endif()
endforeach()
string(JSON value GET "${report}" failed_module_records)
if(NOT value EQUAL 0)
  message(FATAL_ERROR "module failure: ${report}")
endif()
execute_process(COMMAND "${ABCD_FIXTURE}" "${root}" --method RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "bundle fixture failed")
endif()
execute_process(COMMAND "${ABCD_SCAN}" "${root}/index.json" fixture "${root}"
  RESULT_VARIABLE status OUTPUT_QUIET)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "bundle classification failed")
endif()
execute_process(COMMAND "${ABCD_MODULES}" "${root}/index.json" fixture "${root}"
  RESULT_VARIABLE status OUTPUT_VARIABLE report)
if(status EQUAL 0)
  message(FATAL_ERROR "unsupported bundle counted as validated")
endif()
string(JSON value GET "${report}" bundle_files)
string(JSON failures GET "${report}" failed_module_records)
if(NOT value EQUAL 1 OR NOT failures EQUAL 1)
  message(FATAL_ERROR "bundle diagnostic lost: ${report}")
endif()
file(REMOVE_RECURSE "${root}")
