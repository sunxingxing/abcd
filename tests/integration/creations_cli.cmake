string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/creations-${token}")
foreach(mode IN ITEMS --creation-method --creation-nonmethod --creation-unreachable --environment-method --capture-summary --source-exception --invalid-method)
  execute_process(COMMAND "${ABCD_FIXTURE}" "${root}" "${mode}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "fixture failed")
  endif()
  execute_process(COMMAND "${ABCD_SCAN}" "${root}/index.json" fixture "${root}"
    RESULT_VARIABLE status OUTPUT_QUIET)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "scan failed")
  endif()
  execute_process(COMMAND "${ABCD_CREATIONS}" "${root}/index.json" fixture "${root}"
    RESULT_VARIABLE status OUTPUT_VARIABLE report)
  if(mode STREQUAL "--invalid-method")
    if(NOT status EQUAL 1)
      message(FATAL_ERROR "bad encoding accepted: ${status}")
    endif()
  else()
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "inspection failed: ${status} ${report}")
    endif()
    string(JSON snapshots GET "${report}" method_capture_results)
    string(JSON refused GET "${report}" method_capture_failures)
    string(JSON accepted GET "${report}" creation_methods)
    string(JSON peak GET "${report}" method_capture_peak_bytes)
    string(JSON obstacles LENGTH "${report}" method_capture_obstacles)
    math(EXPR accounted "${snapshots} + ${refused}")
    if(NOT accounted EQUAL accepted)
      message(FATAL_ERROR "unaccounted method capture results: ${report}")
    endif()
    if(mode STREQUAL "--creation-nonmethod")
      string(JSON category GET "${report}" method_capture_obstacles 0 category)
      string(JSON occurrences GET "${report}" method_capture_obstacles 0 count)
      if(NOT refused EQUAL 1 OR NOT obstacles EQUAL 1 OR
         NOT category STREQUAL "target" OR NOT occurrences EQUAL 1 OR
         NOT peak EQUAL 0)
        message(FATAL_ERROR "invalid snapshot target accepted: ${report}")
      endif()
    elseif(NOT refused EQUAL 0 OR NOT obstacles EQUAL 0)
      message(FATAL_ERROR "unexpected snapshot refusal: ${report}")
    endif()
    if(mode STREQUAL "--creation-method" OR mode STREQUAL "--environment-method" OR
       mode STREQUAL "--capture-summary")
      if(NOT peak GREATER 0)
        message(FATAL_ERROR "missing retained snapshot payload: ${report}")
      endif()
    endif()
    if(mode STREQUAL "--source-exception")
      string(JSON rejected GET "${report}" creation_rejected_methods)
      if(NOT rejected EQUAL 1)
        message(FATAL_ERROR "missing environment rejection: ${report}")
      endif()
    elseif(mode STREQUAL "--environment-method" OR mode STREQUAL "--capture-summary")
      string(JSON summaries GET "${report}" capture_summary_methods)
      string(JSON slots GET "${report}" capture_unique_slots)
      string(JSON sites GET "${report}" capture_access_sites)
      if(mode STREQUAL "--capture-summary")
        set(expected_slots 2)
        set(expected_sites 3)
      else()
        set(expected_slots 1)
        set(expected_sites 1)
      endif()
      if(NOT summaries EQUAL 1 OR NOT slots EQUAL expected_slots OR NOT sites EQUAL expected_sites)
        message(FATAL_ERROR "incorrect capture summary: ${report}")
      endif()
    elseif(mode STREQUAL "--creation-unreachable")
      string(JSON sites GET "${report}" creation_sites)
      string(JSON unreachable GET "${report}" creation_unreachable_sites)
      string(JSON bound GET "${report}" creation_bound_sites)
      string(JSON failed GET "${report}" creation_failed_sites)
      if(NOT sites EQUAL 1 OR NOT unreachable EQUAL 1 OR NOT bound EQUAL 0 OR NOT failed EQUAL 0)
        message(FATAL_ERROR "unreachable creation was bound: ${report}")
      endif()
    else()
      string(JSON sites GET "${report}" creation_sites)
      string(JSON bound GET "${report}" creation_bound_sites)
      string(JSON failed GET "${report}" creation_failed_sites)
      if(NOT sites EQUAL 2)
        message(FATAL_ERROR "lost distinct creation sites: ${report}")
      endif()
      if(mode STREQUAL "--creation-method")
        string(JSON local GET "${report}" creation_local_captures)
        string(JSON external GET "${report}" creation_external_captures)
        if(NOT bound EQUAL 2 OR NOT failed EQUAL 0 OR NOT local EQUAL 1 OR NOT external EQUAL 1)
          message(FATAL_ERROR "incorrect capture contexts: ${report}")
        endif()
      elseif(NOT bound EQUAL 0 OR NOT failed EQUAL 2)
        message(FATAL_ERROR "non-method target accepted: ${report}")
      endif()
    endif()
  endif()
  string(JSON skipped GET "${report}" static_skipped)
  if(NOT skipped EQUAL 1)
    message(FATAL_ERROR "static exclusion lost")
  endif()
endforeach()
file(REMOVE_RECURSE "${root}")
