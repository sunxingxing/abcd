string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/environments-${token}")
foreach(mode IN ITEMS --environment-method --source-loop --environment-conflict --source-exception --invalid-method)
  execute_process(COMMAND "${ABCD_FIXTURE}" "${root}" "${mode}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "fixture failed")
  endif()
  execute_process(COMMAND "${ABCD_SCAN}" "${root}/index.json" fixture "${root}"
    RESULT_VARIABLE status OUTPUT_QUIET)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "scan failed")
  endif()
  execute_process(COMMAND "${ABCD_ENVIRONMENTS}" "${root}/index.json" fixture "${root}"
    RESULT_VARIABLE status OUTPUT_VARIABLE report)
  if(mode STREQUAL "--invalid-method")
    if(NOT status EQUAL 1)
      message(FATAL_ERROR "bad encoding accepted: ${status}")
    endif()
    string(JSON value GET "${report}" failed_methods)
  else()
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "inspection failed: ${status} ${report}")
    endif()
    if(mode STREQUAL "--environment-conflict" OR mode STREQUAL "--source-exception")
      string(JSON value GET "${report}" environment_rejected)
      string(JSON category GET "${report}" environment_obstacles 0 category)
      if(NOT category STREQUAL "flow")
        message(FATAL_ERROR "missing structural obstacle: ${report}")
      endif()
    else()
      string(JSON value GET "${report}" environment_methods)
      if(mode STREQUAL "--environment-method")
        string(JSON allocations GET "${report}" environment_allocations)
        string(JSON bindings GET "${report}" lexical_bindings)
        string(JSON captures GET "${report}" captured_bindings)
        if(NOT allocations EQUAL 1 OR NOT bindings EQUAL 3 OR NOT captures EQUAL 1)
          message(FATAL_ERROR "incorrect bindings: ${report}")
        endif()
      endif()
    endif()
  endif()
  if(NOT value EQUAL 1)
    message(FATAL_ERROR "incorrect count: ${report}")
  endif()
  string(JSON skipped GET "${report}" static_skipped)
  if(NOT skipped EQUAL 1)
    message(FATAL_ERROR "static exclusion lost")
  endif()
endforeach()
file(REMOVE_RECURSE "${root}")
