string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/record-model-calls-${token}")
execute_process(COMMAND "${ABCD_STRUCTURE}" "${ABCD_SAMPLE}" "${root}" --value-source
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "record source export failed: ${error}")
endif()
file(READ "${root}/manifest.json" manifest)
file(READ "${ABCD_INDEX}" index)
string(JSON entries LENGTH "${index}" entries)
math(EXPR last_entry "${entries} - 1")
set(indexed FALSE)
foreach(i RANGE 0 ${last_entry})
  string(JSON corpus GET "${index}" entries ${i} corpus_id)
  string(JSON path GET "${index}" entries ${i} relative_path)
  if(corpus STREQUAL "paired" AND path STREQUAL "Immersive/modules.abc")
    string(JSON expected_sha GET "${index}" entries ${i} sha256)
    string(JSON expected_size GET "${index}" entries ${i} size)
    set(indexed TRUE)
    break()
  endif()
endforeach()
file(SHA256 "${ABCD_SAMPLE}" actual_sha)
file(SIZE "${ABCD_SAMPLE}" actual_size)
string(JSON manifest_sha GET "${manifest}" sha256)
string(JSON contract GET "${manifest}" source_contract)
string(JSON route GET "${manifest}" source_route)
if(NOT indexed OR NOT actual_sha STREQUAL expected_sha OR
   NOT manifest_sha STREQUAL actual_sha OR NOT actual_size EQUAL expected_size OR
   NOT contract STREQUAL "language_and_host_v3" OR NOT route STREQUAL "value_tree")
  message(FATAL_ERROR "model input identity or source contract mismatch")
endif()
string(JSON count GET "${manifest}" counts records)
math(EXPR last "${count} - 1")
set(icon_path "")
set(section_path "")
set(recommend_path "")
foreach(i RANGE 0 ${last})
  string(JSON entity GET "${manifest}" records ${i} entity)
  if(NOT entity EQUAL 16752 AND NOT entity EQUAL 17544 AND NOT entity EQUAL 17175)
    continue()
  endif()
  string(JSON source ERROR_VARIABLE missing GET "${manifest}" records ${i} source)
  string(JSON source_status GET "${manifest}" records ${i} source_status)
  if(missing OR NOT source_status EQUAL 0)
    message(FATAL_ERROR "model record ${entity} source unavailable")
  endif()
  string(JSON complete GET "${manifest}" records ${i} source_complete)
  string(JSON legacy GET "${manifest}" records ${i} legacy_writer_used)
  string(JSON record_route GET "${manifest}" records ${i} source_route)
  if(NOT complete OR legacy OR NOT record_route STREQUAL "value_tree")
    message(FATAL_ERROR "model record ${entity} requires a complete value-tree record")
  endif()
  if(entity EQUAL 16752)
    set(icon_path "${root}/${source}")
  elseif(entity EQUAL 17544)
    set(section_path "${root}/${source}")
  else()
    set(recommend_path "${root}/${source}")
  endif()
endforeach()
if(icon_path STREQUAL "" OR section_path STREQUAL "" OR recommend_path STREQUAL "")
  message(FATAL_ERROR "model record missing")
endif()
get_filename_component(sample_root "${ABCD_SAMPLE}" DIRECTORY)
set(paired_root "${sample_root}/Immersive_src/shopping/src/main/ets/model")
execute_process(COMMAND "${ABCD_NODE}" --experimental-vm-modules
  "${ABCD_ORACLE}" "${icon_path}" "${section_path}" "${recommend_path}"
  "${paired_root}/IconInfoModel.ts" "${paired_root}/SectionModel.ts" "${paired_root}/RecommendModel.ts"
  RESULT_VARIABLE oracle_status ERROR_VARIABLE oracle_error OUTPUT_VARIABLE oracle_output)
if(NOT oracle_status EQUAL 0)
  message(FATAL_ERROR "model record behavior changed: ${oracle_error}")
endif()
message(STATUS "${oracle_output}")
file(REMOVE_RECURSE "${root}")
