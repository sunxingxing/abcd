string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/historical-source-${token}")
set(constants_entity 4182)
execute_process(COMMAND "${ABCD_STRUCTURE}" "${ABCD_SAMPLE}" "${root}" --value-source
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "historical source export failed: ${error}")
endif()
file(READ "${root}/manifest.json" manifest)
string(JSON count GET "${manifest}" counts records)
math(EXPR last "${count} - 1")
set(found FALSE)
foreach(i RANGE 0 ${last})
  string(JSON entity GET "${manifest}" records ${i} entity)
  if(NOT entity EQUAL constants_entity)
    continue()
  endif()
  string(JSON source ERROR_VARIABLE missing GET "${manifest}" records ${i} source)
  if(missing OR NOT EXISTS "${root}/${source}")
    message(FATAL_ERROR "12.0.6 CommonConstants has no executable source")
  endif()
  execute_process(COMMAND "${ABCD_NODE}" --experimental-vm-modules
    "${ABCD_ORACLE}" "${root}/${source}"
    RESULT_VARIABLE oracle_status ERROR_VARIABLE oracle_error)
  if(NOT oracle_status EQUAL 0)
    message(FATAL_ERROR "historical record oracle failed: ${oracle_error}")
  endif()
  set(found TRUE)
endforeach()
if(NOT found)
  message(FATAL_ERROR "historical CommonConstants record missing")
endif()
# 12.0.2 (MultiCommunity) is an admitted profile. Every record must report a
# self-consistent typed outcome: complete records publish their source file;
# incomplete ones publish only marked partial text; failures name their typed
# domain; records without a module publish nothing. At least one record must
# be completely recovered (capability, not a fixed count).
execute_process(COMMAND "${ABCD_STRUCTURE}" "${ABCD_UNSUPPORTED_SAMPLE}"
  "${root}-unsupported" --value-source RESULT_VARIABLE unsupported_status
  ERROR_VARIABLE unsupported_error)
if(NOT unsupported_status EQUAL 0)
  message(FATAL_ERROR "12.0.2 export failed: ${unsupported_error}")
endif()
file(READ "${root}-unsupported/manifest.json" unsupported_manifest)
string(JSON unsupported_count GET "${unsupported_manifest}" counts records)
math(EXPR unsupported_last "${unsupported_count} - 1")
set(complete_records 0)
foreach(i RANGE 0 ${unsupported_last})
  string(JSON status GET "${unsupported_manifest}" records ${i} source_status)
  string(JSON emitted ERROR_VARIABLE missing GET "${unsupported_manifest}" records ${i} source)
  string(JSON complete ERROR_VARIABLE no_flag GET "${unsupported_manifest}" records ${i} source_complete)
  if(status EQUAL 0)
    if(missing OR no_flag OR NOT complete OR NOT EXISTS "${root}-unsupported/${emitted}")
      message(FATAL_ERROR "complete 12.0.2 record ${i} lost its source")
    endif()
    math(EXPR complete_records "${complete_records} + 1")
  elseif(status EQUAL 4)
    string(JSON partial ERROR_VARIABLE no_partial GET "${unsupported_manifest}" records ${i} incomplete_source)
    if(NOT missing OR no_partial OR complete)
      message(FATAL_ERROR "incomplete 12.0.2 record ${i} claimed complete source")
    endif()
  elseif(status EQUAL 3)
    string(JSON domain GET "${unsupported_manifest}" records ${i} source_failure_domain)
    if(NOT missing OR NOT (domain STREQUAL "record_program" OR domain STREQUAL "route_refusal"))
      message(FATAL_ERROR "failed 12.0.2 record ${i} lacks a typed domain")
    endif()
  elseif(NOT missing)
    message(FATAL_ERROR "12.0.2 record ${i} without module emitted source: ${emitted}")
  endif()
endforeach()
if(complete_records EQUAL 0)
  message(FATAL_ERROR "no 12.0.2 record was completely recovered")
endif()
file(REMOVE_RECURSE "${root}")
file(REMOVE_RECURSE "${root}-unsupported")
