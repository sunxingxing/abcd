string(RANDOM LENGTH 12 token)
set(output "${CMAKE_CURRENT_BINARY_DIR}/constructor-record-${token}")
execute_process(
  COMMAND "${ABCD_STRUCTURE}" "${ABCD_SAMPLE}" "${output}" --source
  RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "record export failed: ${report}${error}")
endif()
file(READ "${output}/manifest.json" manifest)
string(JSON length LENGTH "${manifest}" records)
set(found_home FALSE)
set(found_recommend FALSE)
math(EXPR last "${length} - 1")
foreach(i RANGE 0 ${last})
  string(JSON entity GET "${manifest}" records ${i} entity)
  if(entity EQUAL 28887 OR entity EQUAL 29382)
    string(JSON source_status GET "${manifest}" records ${i} source_status)
    if(NOT source_status EQUAL 0)
      message(FATAL_ERROR "constructor record was rejected: ${entity}")
    endif()
    string(JSON source GET "${manifest}" records ${i} source)
    execute_process(COMMAND "${ABCD_NODE}" --check "${output}/${source}"
      RESULT_VARIABLE parsed ERROR_VARIABLE parse_error)
    if(NOT parsed EQUAL 0)
      message(FATAL_ERROR "generated module failed syntax check: ${parse_error}")
    endif()
    if(entity EQUAL 28887)
      set(found_home TRUE)
    else()
      set(found_recommend TRUE)
    endif()
  endif()
endforeach()
if(NOT found_home OR NOT found_recommend)
  message(FATAL_ERROR "expected viewmodel records were not present")
endif()
file(REMOVE_RECURSE "${output}")
