# Specification only while the user's testing pause remains in force.
# Uses ABC alone, never paired source or source maps; does not execute JS.
execute_process(COMMAND "${ABCD_SEMANTIC}" "${ABCD_SAMPLE}" 7449 --family-source-draft
  RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE failure)
if(NOT status EQUAL 1)
  message(FATAL_ERROR "conditional source must retain incomplete status: ${failure}")
endif()
string(JSON ready GET "${report}" draft_prepared)
string(JSON executable GET "${report}" executable)
string(JSON complete GET "${report}" source_complete)
string(JSON count LENGTH "${report}" draft_positions)
string(JSON named GET "${report}" draft_named_members)
string(JSON source GET "${report}" draft_source)
string(LENGTH "${source}" source_bytes)
if(NOT ready OR executable OR complete OR NOT count EQUAL 4 OR NOT named EQUAL 4)
  message(FATAL_ERROR "expected four conditional source owners")
endif()
set(methods 7449 7089 7117 7477)
foreach(owner RANGE 0 3)
  string(JSON member GET "${report}" draft_positions ${owner})
  string(JSON method GET "${member}" method)
  list(GET methods ${owner} expected)
  if(NOT method EQUAL expected)
    message(FATAL_ERROR "owner identity mismatch")
  endif()
  string(JSON begin GET "${member}" begin)
  string(JSON end GET "${member}" end)
  if(begin LESS 0 OR NOT begin LESS end OR end GREATER source_bytes)
    message(FATAL_ERROR "invalid owner source range")
  endif()
  string(JSON positions GET "${member}" positions)
  string(JSON origins LENGTH "${positions}" origins)
  foreach(kind IN ITEMS expressions properties statements)
    string(JSON nodes LENGTH "${positions}" ${kind})
    if(nodes GREATER 0)
      math(EXPR last "${nodes} - 1")
      foreach(node RANGE ${last})
        string(JSON origin GET "${positions}" ${kind} ${node} origin)
        string(JSON start GET "${positions}" ${kind} ${node} begin)
        string(JSON finish GET "${positions}" ${kind} ${node} end)
        if(origin LESS 0 OR NOT origin LESS origins OR start LESS begin OR
            finish GREATER end OR NOT start LESS finish)
          message(FATAL_ERROR "node escaped its owner or origin arena")
        endif()
      endforeach()
    endif()
  endforeach()
endforeach()
# The removed bytecode prologue maps to the default formal, not a body-wide span.
string(JSON root GET "${report}" draft_positions 0 positions)
string(JSON count LENGTH "${root}" signature)
if(NOT count EQUAL 6)
  message(FATAL_ERROR "lost default-signature operations")
endif()
set(expected_pcs 16 20 21 24 26 31)
foreach(index RANGE 0 5)
  string(JSON origin GET "${root}" signature ${index} origin)
  string(JSON parameter GET "${root}" signature ${index} parameter)
  string(JSON pc GET "${root}" origins ${origin} pc)
  list(GET expected_pcs ${index} expected_pc)
  if(NOT parameter EQUAL 0 OR NOT pc EQUAL expected_pc)
    message(FATAL_ERROR "default signature lost its original PC")
  endif()
endforeach()
string(JSON begin GET "${root}" parameters 0 begin)
string(JSON end GET "${root}" parameters 0 end)
math(EXPR length "${end} - ${begin}")
string(SUBSTRING "${source}" ${begin} ${length} formal)
if(NOT formal STREQUAL "$arg0 = null")
  message(FATAL_ERROR "default-formal event does not locate emitted syntax")
endif()
# The original diagnostic selector must remain source-free.
execute_process(COMMAND "${ABCD_SEMANTIC}" "${ABCD_SAMPLE}" 7449 --conditional-family
  RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE failure)
string(JSON kind ERROR_VARIABLE absent TYPE "${report}" draft_source)
if(NOT status EQUAL 1 OR NOT absent)
  message(FATAL_ERROR "conditional-family unexpectedly published source")
endif()
