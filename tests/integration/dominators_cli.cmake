string(RANDOM LENGTH 12 token)
set(root "${CMAKE_CURRENT_BINARY_DIR}/dominators-${token}")
execute_process(COMMAND "${ABCD_FIXTURE}" "${root}" --method RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "fixture failed")
endif()
execute_process(COMMAND "${ABCD_SCAN}" "${root}/index.json" fixture "${root}"
  RESULT_VARIABLE status OUTPUT_QUIET)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "scan failed")
endif()
execute_process(COMMAND "${ABCD_DOMINATORS}" "${root}/index.json" fixture "${root}"
  RESULT_VARIABLE status OUTPUT_VARIABLE report)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "dominators failed: ${report}")
endif()
foreach(key IN ITEMS dominator_methods reachable_blocks static_skipped)
  string(JSON value GET "${report}" ${key})
  if(NOT value EQUAL 1)
    message(FATAL_ERROR "bad ${key}: ${report}")
  endif()
endforeach()
string(JSON value GET "${report}" failed)
if(NOT value EQUAL 0)
  message(FATAL_ERROR "unexpected failure: ${report}")
endif()
execute_process(COMMAND "${ABCD_FIXTURE}" "${root}" --exception-method RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "exception fixture failed")
endif()
execute_process(COMMAND "${ABCD_SCAN}" "${root}/index.json" fixture "${root}"
  RESULT_VARIABLE status OUTPUT_QUIET)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "exception scan failed")
endif()
execute_process(COMMAND "${ABCD_DOMINATORS}" "${root}/index.json" fixture "${root}"
  RESULT_VARIABLE status OUTPUT_VARIABLE report)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "exception graph failed: ${report}")
endif()
string(JSON reachable GET "${report}" reachable_blocks)
string(JSON blocks GET "${report}" blocks)
if(NOT reachable EQUAL 1 OR NOT blocks EQUAL 3)
  message(FATAL_ERROR "exception-only handlers counted as normally reachable: ${report}")
endif()
file(REMOVE_RECURSE "${root}")
